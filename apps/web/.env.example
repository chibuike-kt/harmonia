# Base URL of the Go backend this frontend talks to (internal/httpapi's
# router, served by cmd/server). No default on purpose — set it per
# environment, e.g. http://localhost:8080 for local dev against `make run`.
NEXT_PUBLIC_API_BASE_URL=

# WebSocket URL of the local companion process (cmd/companion) the
# standalone IDE page connects to — a real local process on the user's
# own machine, never Harmonia's own backend. No default: the /ide page
# shows a real "not configured" state rather than silently trying a
# guessed URL. See internal/companion's own package doc for what this
# process actually does and why it's a separate process at all.
NEXT_PUBLIC_COMPANION_WS_URL=
