# Server
HARMONIA_ENV=development
HARMONIA_HTTP_ADDR=:8080

# Postgres — source of truth
HARMONIA_DATABASE_URL=postgres://harmonia:harmonia@localhost:5432/harmonia?sslmode=disable

# Redis — ephemeral state only (leases, presence). Never source of truth.
HARMONIA_REDIS_ADDR=localhost:6379

# Provider credentials — server-side only, agents never see these directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-agent scoped API keys are issued via the agent registry, not set here.

# GitHub OAuth App — register at github.com/settings/developers, then set
# the callback URL there to match GITHUB_REDIRECT_URI below. Login and
# callback work against a fake OAuth server in tests without these; real
# GitHub sign-in needs all three set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/v1/auth/github/callback

# Google OAuth Client — register at console.cloud.google.com (APIs &
# Services > Credentials), then set the callback URL there to match
# GOOGLE_REDIRECT_URI below. Login and callback work against a fake OIDC
# provider in tests without these; real Google sign-in needs all three set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback

# Where an OAuth callback redirects the browser after issuing a session.
# No frontend exists yet in this backend-only phase; defaults to "/".
HARMONIA_APP_URL=
